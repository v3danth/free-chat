# Copy to .env and fill in. Durations are whole seconds.

# Faces: society marks drawn as poly (low-poly SVG) or pixel (32 x 32 PNG).
AVATAR_STYLE=poly
SERVER_PORT=8080
# true only when running behind your own reverse proxy (Caddy/nginx);
# it makes the server trust X-Forwarded-For for client IPs.
BEHIND_PROXY=false

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=chat_db

# At least 32 characters. Also keys the IP hashes used for bans.
JWT_SECRET=

# Optional: this member is created, or promoted, to admin at startup.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=admin

# Optional: country flags. Download with `make geoip`.
GEOIP_DB_PATH=./data/dbip-country-lite.mmdb

# How long messages and offline guests are kept (default 7 days).
DATA_RETENTION=604800
JANITOR_INTERVAL=600

# Main-room messages a newcomer sees (0-50).
MESSAGE_HISTORY_LIMIT=20
MESSAGE_MAX_LENGTH=1000
MESSAGE_RATE_LIMIT=30
MESSAGE_RATE_WINDOW=60
# New private chats (knocks) one person may start per window, in seconds.
KNOCK_RATE_LIMIT=6
KNOCK_RATE_WINDOW=600
# How long a letter takes to arrive, in seconds (default six hours).
LETTER_DELAY=21600

MEDIA_STORAGE_PATH=./uploads
MEDIA_MAX_UPLOAD_SIZE=10485760

# Optional: GIF search in the picker. giphy (rating r) or tenor
# (contentfilter off), with that library's API key. Empty: the picker
# offers uploads and recents only.
GIF_PROVIDER=
GIF_API_KEY=

# Open reports that hide a message or image until a moderator reviews it.
REPORT_AUTOHIDE_THRESHOLD=3

# Optional: Go's profiler on a loopback address, e.g. localhost:6060.
# Never expose it publicly.
PPROF_ADDR=
